COMPOSE_PROJECT_NAME=kakaotalk-collector
DEVICE_ID=personal-tablet
REDROID_IMAGE=redroid/redroid:14.0.0-latest@sha256:a3e654caad74faed03cd5ead057a989e06f507778cda678e5d3b9772e0092f1c
# ./bridge pins COLLECTOR_IMAGE, DEVICE_IMAGE and GATEWAY_IMAGE when installing a release.
DEVICE_SUBNET=172.29.87.0/24
DEVICE_IP_RANGE=172.29.87.128/25
GATEWAY_IP=172.29.87.3
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
ADB_PORT=5555
RETENTION_DAYS=30
DOT_PUBLIC_URL=https://kakao.example.invalid
DOT_HTTP_PORT=18787

# Passkey confirmation and explicit consent for MCP connections.
DOT_APPROVAL_MODE=passkey

# Configure passkeys with ./bridge passkey-login; local is an explicit fallback.
ADMIN_AUTH_MODE=passkey
