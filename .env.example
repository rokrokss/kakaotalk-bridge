COMPOSE_PROJECT_NAME=kakaotalk-bridge
DEVICE_ID=personal-tablet
REDROID_IMAGE=redroid/redroid:14.0.0-latest@sha256:a3e654caad74faed03cd5ead057a989e06f507778cda678e5d3b9772e0092f1c
# 릴리스를 설치하면 ./bridge가 COLLECTOR_IMAGE, DEVICE_IMAGE, GATEWAY_IMAGE를 고정합니다.
DEVICE_SUBNET=172.29.87.0/24
DEVICE_IP_RANGE=172.29.87.128/25
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
ADB_PORT=5555
RETENTION_DAYS=30
DOT_PUBLIC_URL=https://kakao.example.invalid
DOT_HTTP_PORT=18787
# 로컬 브라우저 또는 SSH 포워딩용 관리 화면. ./bridge up이 자동으로 설정합니다.
ADMIN_LOCAL_PORT=18789
ADMIN_LOCAL_ORIGIN=
ADMIN_LOCAL_HOST=localhost:18789

# 선택 사항인 개인 OpenAI 터널. ./bridge tunnel configure로 설정하세요.
# 실행용 API 키와 비공개 서비스 인증 정보는 이 파일이 아니라 secrets/에 둡니다.
OPENAI_TUNNEL_ENABLED=0
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.15

# MCP 연결은 패스키 확인과 명시적 동의를 거쳐 승인합니다.
DOT_APPROVAL_MODE=passkey

# 패스키는 ./bridge passkey-login으로 설정합니다. local은 명시적으로 고르는 대체 방식입니다.
ADMIN_AUTH_MODE=passkey
