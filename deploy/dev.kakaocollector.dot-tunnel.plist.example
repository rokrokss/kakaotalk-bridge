<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>dev.kakaocollector.dot-tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/absolute/path/kakaotalk-bridge/scripts/dot-tunnel.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/kakaocollector-dot-tunnel.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/kakaocollector-dot-tunnel.out.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
